#!/usr/bin/env bash
# Require a stable GitHub tag, Mix package and Cargo crate to share one version.
set -euo pipefail
[[ $# == 1 ]] || { echo 'Usage: scripts/check-release-version TAG' >&2; exit 64; }
root=$(cd "$(dirname "$0")/.." && pwd)
tag=$1
version=$(tr -d '[:space:]' < "$root/VERSION")
cargo_version=$(awk '
  /^\[package\]$/ { package = 1; next }
  /^\[/ { package = 0 }
  package && /^version = / { gsub(/["[:space:]]/, "", $3); print $3; exit }
' "$root/crates/qredo/Cargo.toml")
[[ "$tag" == "v$version" ]] || {
  echo "Release tag $tag does not match VERSION ($version)" >&2
  exit 1
}
[[ "$cargo_version" == "$version" ]] || {
  echo "Cargo version $cargo_version does not match VERSION ($version)" >&2
  exit 1
}
