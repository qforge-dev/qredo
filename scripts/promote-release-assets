#!/usr/bin/env bash
# Rename commit-addressed CI artifacts for an immutable tagged release.
set -euo pipefail
[[ $# == 2 ]] || { echo 'Usage: scripts/promote-release-assets INPUT_DIR OUTPUT_DIR' >&2; exit 64; }
input=$1
output=$2
source_id=${QREDO_SOURCE_ID:?QREDO_SOURCE_ID is required}
release_id=${QREDO_RELEASE_ID:?QREDO_RELEASE_ID is required}
prefix="qredo-$source_id-"
count=0
mkdir -p "$output"
while IFS= read -r -d '' source; do
    name=${source##*/}
    target=${name#"$prefix"}
    cp "$source" "$output/qredo-$release_id-$target"
    count=$((count + 1))
done < <(find "$input" -type f -name "$prefix*" -print0)
[[ $count -eq 5 ]] || {
    echo "Expected 5 native artifacts for $source_id, found $count" >&2
    exit 1
}
