#!/usr/bin/env bash
# Copy one native target into the release asset naming contract.
set -euo pipefail
[[ $# == 2 ]] || { echo 'Usage: scripts/package-release-asset TARGET OUTPUT_DIR' >&2; exit 64; }
root=$(cd "$(dirname "$0")/.." && pwd)
target=$1
out=$2
release_id=${QREDO_RELEASE_ID:?QREDO_RELEASE_ID is required}
suffix=""
[[ "$target" == *windows* ]] && suffix=".exe"
source="$root/target/$target/release/qredo$suffix"
[[ -f "$source" ]] || { echo "Missing release binary: $source" >&2; exit 1; }
mkdir -p "$out"
asset="$out/qredo-$release_id-$target$suffix"
cp "$source" "$asset"
chmod 755 "$asset" 2>/dev/null || true
test -s "$asset"
