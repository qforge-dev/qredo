#!/usr/bin/env bash
# Quality gate: formatting, lints, tests.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
cargo fmt --all -- --check
cargo clippy --workspace --locked --all-targets -- -D warnings
cargo test --workspace --locked
mix deps.get
mix format --check-formatted
mix test --warnings-as-errors
mix docs --warnings-as-errors
bash scripts/check-hex-package
bash -n scripts/package-release-asset scripts/build-release-targets scripts/check-release-version scripts/check-hex-package scripts/promote-release-assets
bash scripts/check-release-version "v$(tr -d '[:space:]' < VERSION)"
